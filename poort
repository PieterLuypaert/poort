#!/usr/bin/env python3
"""Poort shows which TCP ports are listening and which project each belongs to.

  poort              your dev servers, grouped per project
  poort -a           every listening port, desktop apps and helper processes too
  poort shop          only what belongs to shop (project, branch, folder or tool)
  poort 3000         one port in detail
  poort kill 3000    stop what listens on it: the process, or its container
  poort kill wt1     stop everything of a project or stack, after asking
  poort open 3000    open http://localhost:3000 in the browser
  poort logs 3000    follow its output: docker logs, or the file it writes to
  poort vrij 3000    the first free port from 3000 on
  poort wacht 3000   wait until something listens on 3000

A process belongs to the git checkout it runs from, so a worktree is a project
of its own next to the main checkout of its repo. A port that Docker forwards
is named after its container and belongs to the checkout of its compose
project, except a stack that wt started (compose project <name>-wt<n>): that
belongs to its worktree, found in wt's registry, .git/<name>-worktrees/<n>.env.
Colour is dropped with NO_COLOR or when the output is not a terminal.
"""
import argparse
import glob
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
from collections import Counter
from datetime import datetime, timedelta
from dataclasses import dataclass, field
from typing import Dict, List, Optional, Tuple

HOME = os.path.expanduser("~")

# Executables that run a script: the script names the process, not the binary.
# macOS runs python3 as .../Python.app/Contents/MacOS/Python.
INTERPRETER = re.compile(r"node|bun|deno|python[\d.]*|ruby|php")


@dataclass
class Place:
    repo: str  # folder name of the main checkout
    sub: str  # folder inside the checkout, "" at its root
    branch: str
    is_worktree: bool
    top: str = ""  # root of the checkout
    common: str = ""  # git common dir, where wt keeps its registry


@dataclass
class Stack:
    """A worktree stack that wt started, read from its registry entry."""
    name: str  # wt's project name: shop in the compose project shop-wt1
    index: int
    path: str  # the worktree
    ports: Dict[str, int]  # role (web, api, gcs, ...) to port


@dataclass
class Container:
    name: str
    image: str
    status: str  # docker's "Up 6 days"
    project: str  # compose project, "" outside compose
    service: str
    folder: str  # compose working dir
    inner: Dict[int, int] = field(default_factory=dict)  # host port to container port


@dataclass
class Listener:
    port: int
    pid: int
    command: str  # lsof's short name, the label of last resort
    ppid: int = 0
    elapsed: str = ""  # ps etime: [[dd-]hh:]mm:ss
    args: str = ""
    cwd: str = ""
    place: Optional[Place] = None
    container: Optional[Container] = None
    stack: Optional[Stack] = None
    addresses: List[str] = field(default_factory=list)  # bound to, such as 127.0.0.1 or *
    tty: str = ""  # ps tty, ?? without a terminal
    rss_kb: int = 0
    cpu: str = ""
    # Only read for the detail views (deep=True):
    parent: str = ""  # short command line of the parent
    log: str = ""  # the file stdout goes to
    connections: int = -1


def run(cmd: List[str]) -> str:
    """Stdout of cmd. lsof exits 1 on any missing pid and git outside a repo,
    so the exit code is no sign of failure here; a missing tool gives ""."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout
    except FileNotFoundError:
        return ""


def port_of(address: str) -> Optional[int]:
    """The port of an lsof address such as 127.0.0.1:8000, *:80 or [::1]:3000."""
    port = address.rpartition(":")[2]
    return int(port) if port.isdigit() else None


def parse_lsof(text: str) -> List[Listener]:
    """One Listener per port and pid from `lsof -F pcn` output; a process that
    listens on both IPv4 and IPv6 is counted once."""
    found = {}
    pid, command = 0, ""
    for line in text.splitlines():
        field, value = line[:1], line[1:]
        if field == "p":
            pid = int(value)
        elif field == "c":
            command = value
        elif field == "n":
            port = port_of(value)
            if port is not None:
                item = found.setdefault((port, pid), Listener(port, pid, command))
                address = value.rpartition(":")[0]
                if address not in item.addresses:
                    item.addresses.append(address)
    return list(found.values())


def place_of(cwd: str) -> Optional[Place]:
    if not cwd or cwd == "/":
        return None
    out = run([
        "git", "-C", cwd, "rev-parse", "--path-format=absolute",
        "--show-toplevel", "--git-common-dir", "--abbrev-ref", "HEAD",
    ]).splitlines()
    if len(out) != 3:
        return None
    top, common, branch = os.path.realpath(out[0]), os.path.realpath(out[1]), out[2]
    main = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    sub = os.path.relpath(os.path.realpath(cwd), top)
    repo = os.path.basename(main)
    return Place(
        repo=repo[:-4] if repo.endswith(".git") else repo,
        sub="" if sub == "." else sub,
        branch=branch,
        is_worktree=top != main,
        top=top,
        common=common,
    )


def read_stacks(common: str) -> List[Stack]:
    """wt's registry next to a git dir: one <common>/<name>-worktrees/<n>.env
    per worktree, with REG_PATH and a REG_<ROLE> line per port."""
    stacks = []
    for entry in sorted(glob.glob(os.path.join(common, "*-worktrees", "*.env"))):
        index = os.path.basename(entry)[: -len(".env")]
        if not index.isdigit():
            continue
        values = {}
        with open(entry) as lines:
            for line in lines:
                key, sep, value = line.strip().partition("=")
                if sep and key.startswith("REG_"):
                    values[key[4:].lower()] = value.strip('"')
        ports = {role: int(value) for role, value in values.items() if value.isdigit() and role != "pr"}
        name = os.path.basename(os.path.dirname(entry))[: -len("-worktrees")]
        stacks.append(Stack(name, int(index), values.get("path", ""), ports))
    return stacks


class Lookup:
    """Places and registries found during one scan: many ports share a folder."""

    def __init__(self):
        self.places: Dict[str, Optional[Place]] = {}
        self.stacks: Dict[str, List[Stack]] = {}

    def place(self, path: str) -> Optional[Place]:
        if path not in self.places:
            self.places[path] = place_of(path)
        return self.places[path]

    def stacks_of(self, place: Place) -> List[Stack]:
        if place.common not in self.stacks:
            self.stacks[place.common] = read_stacks(place.common)
        return self.stacks[place.common]

    def stack_at(self, place: Place) -> Optional[Stack]:
        return next((stack for stack in self.stacks_of(place)
                     if os.path.realpath(stack.path) == place.top), None)

    def container_home(self, container: "Container") -> Tuple[Optional[Place], Optional[Stack]]:
        """The checkout a container belongs to: its wt worktree when wt started
        it, else the checkout of its compose folder."""
        home = self.place(container.folder) if container.folder else None
        match = re.fullmatch(r"(.+)-wt(\d+)", container.project)
        if home and match:
            for stack in self.stacks_of(home):
                if (stack.name, stack.index) == (match.group(1), int(match.group(2))) and stack.path:
                    return self.place(stack.path), stack
        return home, None


def add_process_info(listeners: List[Listener], lookup: Lookup) -> None:
    """Fill in parent, age, command line, working folder and place."""
    pids = ",".join(sorted({str(item.pid) for item in listeners}))
    info = {}
    for line in run(["ps", "-o", "pid=,ppid=,etime=,tty=,rss=,%cpu=,command=", "-p", pids]).splitlines():
        parts = line.split(None, 6)
        if len(parts) == 7:
            info[int(parts[0])] = parts[1:]
    cwds, pid = {}, 0
    for line in run(["lsof", "-a", "-p", pids, "-d", "cwd", "-Fpn"]).splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n"):
            cwds[pid] = line[1:]
    for item in listeners:
        if item.pid in info:
            ppid, item.elapsed, item.tty, rss, item.cpu, item.args = info[item.pid]
            item.ppid, item.rss_kb = int(ppid), int(rss) if rss.isdigit() else 0
        item.cwd = cwds.get(item.pid, "")
        item.place = lookup.place(item.cwd)


DOCKER_FORMAT = "\t".join([
    "{{.Names}}", "{{.Image}}", "{{.Ports}}", "{{.Status}}",
    '{{.Label "com.docker.compose.project"}}',
    '{{.Label "com.docker.compose.service"}}',
    '{{.Label "com.docker.compose.project.working_dir"}}',
])


def parse_docker(text: str) -> Dict[int, Container]:
    """Containers by the host ports they publish, from `docker ps` in DOCKER_FORMAT."""
    by_port = {}
    for line in text.splitlines():
        fields = line.split("\t")
        if len(fields) != 7:
            continue
        name, image, ports, status, project, service, folder = fields
        container = Container(name, image, status, project, service, folder)
        for match in re.finditer(r":(\d+)(?:-(\d+))?->(\d+)(?:-\d+)?/tcp", ports):
            first, inner = int(match.group(1)), int(match.group(3))
            for offset in range(int(match.group(2) or first) - first + 1):
                by_port[first + offset] = container
                container.inner[first + offset] = inner + offset
    return by_port


def short_command(args: str) -> str:
    """A command line without the interpreter and paths: pnpm dev, vite --port 1."""
    words = args.split()
    if len(words) > 1 and INTERPRETER.fullmatch(os.path.basename(words[0]).lower()) \
            and not words[1].startswith("-"):
        words = words[1:]
    return " ".join([os.path.basename(words[0])] + words[1:]) if words else ""


def count_connections(text: str) -> Counter:
    """Open connections per local port, from `lsof -F n` on established sockets."""
    counts: Counter = Counter()
    for line in text.splitlines():
        if line.startswith("n") and "->" in line:
            port = port_of(line[1:].partition("->")[0])
            if port is not None:
                counts[port] += 1
    return counts


def find_logs(text: str) -> Dict[int, str]:
    """Per pid the file its output goes to, from `lsof -F pftn`: stdout when
    that is a file, else the first .log file it has open (symfony's server)."""
    stdout, open_logs = {}, {}
    pid, fd, kind = 0, "", ""
    for line in text.splitlines():
        tag, value = line[:1], line[1:]
        if tag == "p":
            pid = int(value)
        elif tag == "f":
            fd = value
        elif tag == "t":
            kind = value
        elif tag == "n" and kind == "REG":
            if fd == "1":
                stdout[pid] = value
            elif value.endswith(".log"):
                open_logs.setdefault(pid, value)
    return {**open_logs, **stdout}


def add_deep_info(listeners: List[Listener]) -> None:
    """Parents, output files and open connections, for the detail views."""
    ppids = ",".join(sorted({str(item.ppid) for item in listeners if item.ppid > 1}))
    parents = {}
    for line in (run(["ps", "-o", "pid=,command=", "-p", ppids]) if ppids else "").splitlines():
        pid, _, args = line.strip().partition(" ")
        if pid.isdigit():
            parents[int(pid)] = short_command(args.strip())
    pids = ",".join(sorted({str(item.pid) for item in listeners}))
    logs = find_logs(run(["lsof", "-p", pids, "-Fpftn"]))
    counts = count_connections(run(["lsof", "-nP", "-iTCP", "-sTCP:ESTABLISHED", "-Fn"]))
    for item in listeners:
        item.parent = parents.get(item.ppid, "")
        item.log = logs.get(item.pid, "")
        item.connections = counts.get(item.port, 0)


def read_listeners(deep: bool = False) -> List[Listener]:
    listeners = parse_lsof(run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-Fpcn"]))
    if not listeners:
        return listeners
    lookup = Lookup()
    add_process_info(listeners, lookup)
    # Without Docker, or with its daemon down, this is empty.
    containers = parse_docker(run(["docker", "ps", "--format", DOCKER_FORMAT]))
    for item in listeners:
        item.container = containers.get(item.port)
        if item.container:
            item.place, item.stack = lookup.container_home(item.container)
        elif item.place:
            item.stack = lookup.stack_at(item.place)
    if deep:
        add_deep_info(listeners)
    return listeners


def one_per_port(listeners: List[Listener]) -> List[Listener]:
    """One process per port, sorted by port. When workers share the port with
    their parent (php-fpm), the parent stands for them."""
    by_port = {}
    for item in listeners:
        by_port.setdefault(item.port, []).append(item)
    kept = []
    for _, group in sorted(by_port.items()):
        pids = {item.pid for item in group}
        roots = [item for item in group if item.ppid not in pids]
        kept.append(min(roots or group, key=lambda item: item.pid))
    return kept


def drop_helpers(rows: List[Listener]) -> List[Listener]:
    """Drop a process whose parent listens too, such as php-fpm under the
    symfony server: its port is internal."""
    pids = {item.pid for item in rows}
    return [item for item in rows if item.ppid not in pids]


def is_dev(item: Listener) -> bool:
    """Dev servers run from a folder in your home; desktop apps run from /."""
    return bool(item.container) or item.cwd == HOME or item.cwd.startswith(HOME + os.sep)


def label(item: Listener) -> str:
    """A short name: the compose service, the tool (vite, next-server,
    symfony) or the script."""
    if item.container:
        return item.container.service or item.container.name
    words = item.args.split()
    if not words:
        return item.command
    exe = os.path.basename(words[0]).rstrip(":")
    if not INTERPRETER.fullmatch(exe.lower()):
        return exe
    exe = exe.lower()
    package = re.search(r"node_modules/(?:\.bin/(?:\.\./)?)?((?:@[^/\s]+/)?[^/\s]+)", item.args)
    if package:
        return package.group(1)
    script = next((word for word in words[1:] if not word.startswith("-")), "")
    if os.path.isabs(script):
        script = os.path.basename(script)
    return f"{exe} {script}" if script else exe


def tilde(path: str) -> str:
    if path == HOME or path.startswith(HOME + os.sep):
        return "~" + path[len(HOME):]
    return path


def short_duration(seconds: int) -> str:
    if seconds < 60:
        return "<1m"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}u"
    return f"{seconds // 86400}d"


UNIT_SECONDS = {"second": 1, "minute": 60, "hour": 3600, "day": 86400,
                "week": 7 * 86400, "month": 30 * 86400, "year": 365 * 86400}


def docker_age(status: str) -> str:
    """Docker's "Up 6 days (healthy)" or "Up About an hour" as 6d or 1u."""
    match = re.match(r"Up (?:About |Less than )?(an?|\d+) (second|minute|hour|day|week|month|year)", status)
    if not match:
        return ""
    count = int(match.group(1)) if match.group(1).isdigit() else 1
    return short_duration(count * UNIT_SECONDS[match.group(2)])


def age_of(item: Listener) -> str:
    return docker_age(item.container.status) if item.container else short_age(item.elapsed)


def etime_seconds(etime: str) -> Optional[int]:
    """ps etime ([[dd-]hh:]mm:ss) in seconds."""
    days, _, clock = etime.strip().rpartition("-")
    parts = clock.split(":")
    if not (days or "0").isdigit() or not 2 <= len(parts) <= 3 or not all(p.isdigit() for p in parts):
        return None
    seconds = 0
    for part in parts:
        seconds = seconds * 60 + int(part)
    return int(days or 0) * 86400 + seconds


def short_age(etime: str) -> str:
    """ps etime as <1m, 12m, 3u or 6d."""
    seconds = etime_seconds(etime)
    return "" if seconds is None else short_duration(seconds)


DAYS = ["ma", "di", "wo", "do", "vr", "za", "zo"]
MONTHS = ["jan", "feb", "mrt", "apr", "mei", "jun", "jul", "aug", "sep", "okt", "nov", "dec"]


def started_at(seconds_ago: int, now: Optional[datetime] = None) -> str:
    """When something started: vandaag 09:02, gisteren 14:10 or vr 9 okt 09:02."""
    now = now or datetime.now()
    start = now - timedelta(seconds=seconds_ago)
    clock = start.strftime("%H:%M")
    if start.date() == now.date():
        return f"vandaag {clock}"
    if start.date() == (now - timedelta(days=1)).date():
        return f"gisteren {clock}"
    return f"{DAYS[start.weekday()]} {start.day} {MONTHS[start.month - 1]} {clock}"


class Paint:
    """ANSI colour when on, plain text when off."""

    def __init__(self, on: bool):
        self.on = on

    def __call__(self, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.on and code and text.strip() else text

    def link(self, url: str) -> str:
        """A clickable url (OSC 8) in terminals that know them."""
        return f"\033]8;;{url}\033\\{self(LINK, url)}\033]8;;\033\\" if self.on else url


BOLD, DIM, WORKTREE, GONE, FREE, ACCENT, LINK = "1", "90", "33", "31", "32", "1;38;5;208", "4;36"


def clip(text: str, width: int) -> str:
    return text if len(text) <= width else text[: max(width - 1, 0)] + "…"


def fit(widths: List[int], mins: List[int], room: int) -> List[int]:
    """Narrow the widest column, a character at a time, until all fit in room."""
    widths = list(widths)
    while sum(widths) > room:
        i = max(range(len(widths)), key=lambda i: widths[i] - mins[i])
        if widths[i] <= mins[i]:
            break
        widths[i] -= 1
    return widths


def is_orphan(item: Listener) -> bool:
    """Still running from a folder that was deleted, such as a removed worktree."""
    return bool(item.cwd) and not os.path.isdir(item.cwd)


@dataclass
class Group:
    """The ports of one project: a checkout, a docker project or a folder."""
    title: str
    branch: str = ""
    is_worktree: bool = False
    path: str = ""
    rows: List[Listener] = field(default_factory=list)


ORPHANS, OTHERS = "map is weg", "overig"


def group_of(item: Listener) -> Tuple[tuple, Group]:
    """The group a port belongs to, with its sort key: checkouts by repo with
    the main checkout first, then docker projects, plain folders, servers whose
    folder is gone, and apps."""
    if item.place:
        place = item.place
        key = (0, place.repo, place.is_worktree, place.branch, place.top)
        return key, Group(place.repo, place.branch, place.is_worktree, tilde(place.top))
    if item.container:
        title = f"docker {item.container.project or item.container.name}"
        return (1, title), Group(title, path=tilde(item.container.folder))
    if is_orphan(item):
        return (3,), Group(ORPHANS)
    if is_dev(item):
        return (2, item.cwd), Group(os.path.basename(item.cwd), path=tilde(item.cwd))
    return (4,), Group(OTHERS)


def group_rows(rows: List[Listener]) -> List[Group]:
    groups: Dict[tuple, Group] = {}
    for item in rows:
        key, group = group_of(item)
        groups.setdefault(key, group).rows.append(item)
    return [groups[key] for key in sorted(groups)]


def where(item: Listener) -> str:
    """Where inside its project a port runs: the folder, or the docker project."""
    if item.container:
        return f"docker {item.container.project or item.container.name}"
    if item.place:
        return item.place.sub
    return tilde(item.cwd) if is_orphan(item) else ""


def branch_text(branch: str, is_worktree: bool) -> str:
    return f"wt {branch}" if is_worktree else branch


def render_header(group: Group, paint: Paint, width: int) -> str:
    tone = GONE if group.title == ORPHANS else DIM if group.title == OTHERS else ACCENT
    title = clip(group.title, width - 2)
    branch = branch_text(group.branch, group.is_worktree)
    gaps = 2 * (bool(branch) + bool(group.path))
    branch_w, path_w = fit([len(branch), len(group.path)], [min(len(branch), 12), 0],
                           width - 2 - len(title) - gaps)
    line = "  " + paint(tone, title)
    if branch and branch_w > 0:
        branch = clip(branch, branch_w)
        if group.is_worktree:
            line += "  " + paint(WORKTREE, branch[:2]) + branch[2:]
        else:
            line += "  " + branch
    if group.path and path_w >= min(len(group.path), 4):
        line += "  " + paint(DIM, clip(group.path, path_w))
    return line


def render_groups(groups: List[Group], paint: Paint, width: int) -> List[str]:
    rows = [item for group in groups for item in group.rows]
    whats = {item.port: label(item) for item in rows}
    wheres = {item.port: where(item) for item in rows}
    images = {item.port: item.container.image if item.container else "" for item in rows}
    ages = {item.port: age_of(item) for item in rows}
    # Docker's own pid says nothing about the container.
    pids = {item.port: "" if item.container else f"pid {item.pid}" for item in rows}
    port_w = max(len(str(item.port)) for item in rows)
    age_w, pid_w = (max(map(len, col.values())) for col in (ages, pids))
    widths = [max(map(len, col.values())) for col in (whats, wheres, images)]
    gaps = 2 * (2 + sum(1 for w in widths if w))
    what_w, where_w, image_w = fit(widths, [min(w, 12) for w in widths],
                                   width - 4 - port_w - age_w - pid_w - gaps)
    lines = []
    for group in groups:
        if lines:
            lines.append("")
        lines.append(render_header(group, paint, width))
        for item in group.rows:
            cells = [paint(BOLD, str(item.port).rjust(port_w)), clip(whats[item.port], what_w).ljust(what_w)]
            if where_w:
                tone = GONE if is_orphan(item) else ""
                cells.append(paint(tone, clip(wheres[item.port], where_w).ljust(where_w)) if tone
                             else clip(wheres[item.port], where_w).ljust(where_w))
            if image_w:
                cells.append(paint(DIM, clip(images[item.port], image_w).ljust(image_w)))
            cells += [paint(DIM, ages[item.port].rjust(age_w)), paint(DIM, pids[item.port])]
            lines.append(("    " + "  ".join(cells)).rstrip())
    return lines


def haystack(item: Listener) -> str:
    """Everything a filter word can match, lower case."""
    words = [label(item), item.cwd]
    if item.place:
        words += [item.place.repo, item.place.branch, item.place.top]
    if item.container:
        c = item.container
        words += [c.name, c.project, c.service, c.image]
    if item.stack:
        words.append(f"wt{item.stack.index}")
    if is_orphan(item):
        words.append(ORPHANS)
    return "\n".join(words).lower()


def matches(item: Listener, terms: List[str]) -> bool:
    """True when any of the filter words occurs in the port's project, branch,
    folder, tool or container."""
    text = haystack(item)
    return any(term.lower() in text for term in terms)


def terminal_width() -> int:
    """The terminal's width; a pty that reports none still gets room to work in."""
    columns = shutil.get_terminal_size((120, 24)).columns
    return columns if columns >= 40 else 120


def plural(count: int, one: str, many: str) -> str:
    return f"{count} {one if count == 1 else many}"


# Ports that speak a database protocol, not http: no url for them.
NOT_HTTP = {3306, 5432, 6379, 9042, 11211, 27017, 5672}
LOOPBACK = re.compile(r"127\.[\d.]+|\[::1\]|localhost")


def url_of(item: Listener) -> str:
    inner = item.container.inner.get(item.port) if item.container else None
    if item.port in NOT_HTTP or inner in NOT_HTTP:
        return ""
    # The symfony server speaks https unless started with --no-tls.
    secure = label(item) == "symfony" and "--no-tls" not in item.args
    return f"{'https' if secure else 'http'}://localhost:{item.port}"


def is_local_only(item: Listener) -> bool:
    return bool(item.addresses) and all(LOOPBACK.fullmatch(address) for address in item.addresses)


def output_of(item: Listener) -> str:
    """Where a process's output goes."""
    if item.log:
        return tilde(item.log)
    if item.tty and item.tty != "??":
        return f"terminal {item.tty}"
    return "geen terminal of logbestand"


def detail_fields(item: Listener) -> List[Tuple[str, str, str, str]]:
    """Key, value, the value's tone and a dim note per line of the detail views."""
    fields = []

    def add(key: str, value: str, tone: str = "", note: str = "") -> None:
        fields.append((key, value, tone, note))

    if item.place:
        add("project", f"{item.place.repo} · {branch_text(item.place.branch, item.place.is_worktree)}")
    if item.stack:
        role = next((role for role, port in item.stack.ports.items() if port == item.port), "")
        add("stack", f"wt {item.stack.index} van {item.stack.name}", note=role)
    if item.container:
        c = item.container
        add("container", c.name)
        add("image", c.image)
        if c.project:
            add("compose", f"{c.project} · {c.service}", note=tilde(c.folder))
        inner = c.inner.get(item.port)
        if inner and inner != item.port:
            add("binnenin", f"poort {inner} in de container")
        add("status", c.status, GONE if "unhealthy" in c.status else "")
    else:
        orphan = is_orphan(item)
        add("map", tilde(item.cwd), GONE if orphan else "", "is weg" if orphan else "")
        add("commando", item.args.replace(HOME, "~") or item.command)
        parent = f"gestart door {item.parent} ({item.ppid})" if item.parent else \
            "losgekoppeld van zijn terminal" if item.ppid == 1 else ""
        add("pid", str(item.pid), note=parent)
        seconds = etime_seconds(item.elapsed)
        add("draait", age_of(item), note=f"sinds {started_at(seconds)}" if seconds is not None else "")
        if item.rss_kb:
            add("geheugen", f"{round(item.rss_kb / 1024)} MB", note=f"cpu {item.cpu}%")
        add("uitvoer", output_of(item))
    if item.addresses:
        if is_local_only(item):
            add("bereik", "alleen deze Mac", note=" ".join(item.addresses))
        else:
            add("bereik", "ook vanaf je netwerk", WORKTREE, " ".join(item.addresses))
    if item.connections >= 0:
        add("verbindingen", f"{item.connections} open")
    return fields


def hints_for(item: Listener) -> List[str]:
    hints = []
    if url_of(item):
        hints.append(f"poort open {item.port}")
    if item.container or item.log:
        hints.append(f"poort logs {item.port}")
    hints.append(f"poort kill {item.port}")
    return hints


def render_detail(item: Listener, paint: Paint) -> List[str]:
    port = str(item.port)
    url = url_of(item)
    lines = [f"  {paint(BOLD, port)}  {paint(BOLD, label(item))}" + (f"  {paint.link(url)}" if url else "")]
    indent = " " * (len(port) + 4)
    key_w = max(len(key) for key, *_ in detail_fields(item)) + 2
    for key, value, tone, note in detail_fields(item):
        lines.append(f"{indent}{paint(DIM, key.ljust(key_w))}{paint(tone, value)}"
                     + (f"  {paint(DIM, note)}" if note else ""))
    lines.append("")
    lines.append(indent + paint(DIM, "  ·  ".join(hints_for(item))))
    return lines


LSOF_LISTEN = ["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-Fpcn"]


def listening_ports() -> set:
    return {item.port for item in parse_lsof(run(LSOF_LISTEN))}


def listening_pids(port: int) -> List[int]:
    return [int(pid) for pid in run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"]).split()]


def wait_for_ports(ports: List[int], seconds: float) -> set:
    """Wait until none of ports listens; the ones still taken when time is up."""
    deadline = time.monotonic() + seconds
    while True:
        busy = set(ports) & listening_ports()
        if not busy or time.monotonic() > deadline:
            return busy
        time.sleep(0.1)


def send(pid: int, sig: int) -> Optional[str]:
    """Signal pid; a reason when that is not allowed. A pid that is already
    gone is fine: it was going to stop anyway."""
    try:
        os.kill(pid, sig)
    except ProcessLookupError:
        pass
    except PermissionError:
        return f"geen rechten om pid {pid} te stoppen"
    return None


def stop_many(rows: List[Listener]) -> Dict[int, Optional[str]]:
    """Free the ports of rows: one docker stop for the containers, SIGTERM for
    the processes and after five seconds SIGKILL for whatever still listens on
    their ports. Per port None once free, else the reason it is still taken."""
    problems: Dict[int, str] = {}
    containers = [item for item in rows if item.container]
    if containers:
        names = sorted({item.container.name for item in containers})
        done = subprocess.run(["docker", "stop", *names], capture_output=True, text=True, timeout=120)
        if done.returncode != 0:
            reason = (done.stderr.strip().splitlines() or ["docker stop mislukte"])[-1]
            problems.update((item.port, reason) for item in containers)
    processes = [item for item in rows if not item.container]
    for item in processes:
        problem = send(item.pid, signal.SIGTERM)
        if problem:
            problems[item.port] = problem
    busy = wait_for_ports([item.port for item in rows if item.port not in problems], 5)
    # Only a process gets SIGKILL: on a container's port listens Docker itself.
    for item in processes:
        if item.port in busy:
            for pid in listening_pids(item.port):
                problem = send(pid, signal.SIGKILL)
                if problem:
                    problems[item.port] = problem
    if busy:
        wait_for_ports(list(busy), 2)
    taken = listening_ports()
    return {item.port: problems.get(item.port, "de poort bleef bezet") if item.port in taken else None
            for item in rows}


def stop(item: Listener) -> Optional[str]:
    return stop_many([item])[item.port]


def show_ports(ports: List[int], rows: List[Listener], paint: Paint) -> int:
    by_port = {item.port: item for item in rows}
    lines = []
    for port in ports:
        item = by_port.get(port)
        if lines:
            lines.append("")
        if item:
            lines += render_detail(item, paint)
        else:
            lines.append(f"  {paint(BOLD, str(port))} is {paint(FREE, 'vrij')}.")
    print("\n" + "\n".join(lines) + "\n")
    return 0


def pick_targets(rows: List[Listener], ports: List[int], terms: List[str]) -> Tuple[List[Listener], List[int]]:
    """What to stop, by port, and the asked ports that are already free. A
    word picks every dev server it matches; helpers stop with their parent."""
    by_port = {item.port: item for item in rows}
    chosen = {port: by_port[port] for port in ports if port in by_port}
    if terms:
        for item in visible(rows, terms, show_all=False):
            chosen.setdefault(item.port, item)
    return [chosen[port] for port in sorted(chosen)], [port for port in ports if port not in by_port]


def confirm(question: str) -> Optional[bool]:
    """Ask yes or no on the terminal; None when there is no one to ask."""
    if not sys.stdin.isatty():
        return None
    try:
        return input(question).strip().lower() in ("j", "ja", "y", "yes")
    except EOFError:
        return False


def kill(rows: List[Listener], ports: List[int], terms: List[str], sure: bool, paint: Paint,
         ask=confirm) -> int:
    """Stop the asked ports at once; a project or stack only after a yes."""
    targets, free = pick_targets(rows, ports, terms)
    lines = [f"  {paint(BOLD, str(port))} is al {paint(FREE, 'vrij')}." for port in free]
    if terms and not targets:
        print(f"\n  Niets gevonden voor {' '.join(terms)}.\n")
        return 1
    if terms and not sure:
        width = terminal_width()
        print("\n" + "\n".join(render_groups(group_rows(targets), paint, width)) + "\n", flush=True)
        answer = ask(f"  {plural(len(targets), 'poort', 'poorten')} stoppen? [j/N] ")
        if answer is None:
            print("  Geen terminal om te vragen: voeg -j toe om zonder vragen te stoppen.\n", file=sys.stderr)
            return 2
        if not answer:
            print("  Niets gestopt.\n")
            return 1
    results = stop_many(targets) if targets else {}
    port_w = max([len(str(item.port)) for item in targets] + [0])
    for item in targets:
        name = paint(BOLD, str(item.port).rjust(port_w))
        problem = results[item.port]
        if problem:
            lines.append(f"  {name} is nog bezet: {paint(GONE, problem)}")
        else:
            lines.append(f"  {name} is {paint(FREE, 'vrij')}.  {paint(DIM, f'{label(item)} gestopt')}")
    print("\n" + "\n".join(lines) + "\n")
    return 1 if any(results.values()) else 0


def logs_command(item: Listener, lines: int, follow: bool) -> Optional[List[str]]:
    """The command that shows a port's output, or None when it writes to no file."""
    if item.container:
        return ["docker", "logs", "--tail", str(lines)] + (["--follow"] if follow else []) + [item.container.name]
    if item.log:
        return ["tail", "-n", str(lines)] + (["-F"] if follow else []) + [item.log]
    return None


def is_bindable(port: int) -> bool:
    """True when a server could listen on port, on localhost and on all addresses."""
    for host in ("127.0.0.1", "0.0.0.0"):
        with socket.socket() as sock:
            try:
                sock.bind((host, port))
            except OSError:
                return False
    return True


def free_ports(start: int, count: int, taken: set) -> List[int]:
    found, port = [], start
    while len(found) < count and port < 65536:
        if port not in taken and is_bindable(port):
            found.append(port)
        port += 1
    return found


SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


def wait_for_listen(ports: List[int], timeout: float, tick=None) -> Tuple[bool, float]:
    """Wait until every port listens; whether they did, and after how long.
    A timeout of 0 waits for ever. tick(seconds, waiting) runs on every check."""
    start = time.monotonic()
    while True:
        waited = time.monotonic() - start
        waiting = [port for port in ports if port not in listening_ports()]
        if not waiting:
            return True, waited
        if timeout and waited >= timeout:
            return False, waited
        if tick:
            tick(waited, waiting)
        time.sleep(0.25)


def opener() -> str:
    return "open" if sys.platform == "darwin" else "xdg-open"


def port_number(text: str) -> int:
    if not text.isdigit() or not 0 < int(text) < 65536:
        raise argparse.ArgumentTypeError(f"geen poort: {text}")
    return int(text)


def split_targets(words: List[str]) -> Tuple[List[int], List[str]]:
    """Port numbers and filter words."""
    ports, terms = [], []
    for word in words:
        if word.isdigit():
            ports.append(port_number(word))
        else:
            terms.append(word)
    return ports, terms


def visible(rows: List[Listener], terms: List[str], show_all: bool) -> List[Listener]:
    """The rows to list: dev servers, or everything with -a. A filter that finds
    nothing among the dev servers also looks at apps, so `poort spotify` works."""
    dev = rows if show_all else [item for item in drop_helpers(rows) if is_dev(item)]
    if not terms:
        return dev
    found = [item for item in dev if matches(item, terms)]
    return found or [item for item in rows if matches(item, terms)]


def show_list(rows: List[Listener], terms: List[str], show_all: bool, paint: Paint) -> int:
    rows = visible(rows, terms, show_all)
    if not rows:
        if terms:
            print(f"\n  Niets gevonden voor {' '.join(terms)}.\n")
            return 1
        print("\n  Niets luistert." + ("" if show_all else " poort -a toont ook apps.") + "\n")
        return 0
    width = terminal_width()
    groups = group_rows(rows)
    print("\n" + "\n".join(render_groups(groups, paint, width)) + "\n")
    if sys.stdout.isatty():
        summary = f"{plural(len(rows), 'poort', 'poorten')} in {plural(len(groups), 'project', 'projecten')}"
        print(f"  {paint(DIM, summary)}\n")
    return 0


HELP = """\
  poort                    je dev servers, per project
  poort shop                alleen wat bij shop hoort (project, branch, map, tool)
  poort 3000               een poort in detail
  poort kill 3000 8000     stop wat daar luistert
  poort kill wt1           stop alles van een project of stack (vraagt eerst)
  poort open 3000/admin    open http://localhost:3000/admin in je browser
  poort logs 3000          volg de uitvoer: docker logs, of het bestand waar hij naar schrijft
  poort vrij 3000          de eerste vrije poort vanaf 3000
  poort wacht 3000         wacht tot er iets op 3000 luistert (handig in scripts)
"""


def parser_for(command: str, description: str) -> argparse.ArgumentParser:
    return argparse.ArgumentParser(prog=f"poort {command}".strip(), description=description,
                                   epilog=HELP, formatter_class=argparse.RawDescriptionHelpFormatter)


def targets_of(parser: argparse.ArgumentParser, words: List[str]) -> Tuple[List[int], List[str]]:
    try:
        return split_targets(words)
    except argparse.ArgumentTypeError as error:
        parser.error(str(error))


def paint_for_stdout() -> Paint:
    return Paint(sys.stdout.isatty() and "NO_COLOR" not in os.environ)


def cmd_show(argv: List[str]) -> int:
    parser = parser_for("", "Wie luistert op welke poort, per project.")
    parser.add_argument("targets", nargs="*", metavar="poort|filter",
                        help="een poortnummer toont die poort in detail; een woord filtert op project")
    parser.add_argument("-a", "--all", action="store_true", help="ook apps en hulpprocessen")
    parser.add_argument("-k", "--kill", action="store_true", help="hetzelfde als poort kill")
    args = parser.parse_args(argv)
    ports, terms = targets_of(parser, args.targets)
    if args.kill:
        return cmd_kill(args.targets)
    rows = one_per_port(read_listeners(deep=bool(ports)))
    if ports:
        return show_ports(ports, rows, paint_for_stdout())
    return show_list(rows, terms, args.all, paint_for_stdout())


def cmd_kill(argv: List[str]) -> int:
    parser = parser_for("kill", "Stop wat op een poort luistert, of alles van een project of stack.")
    parser.add_argument("targets", nargs="+", metavar="poort|project")
    parser.add_argument("-j", "--ja", action="store_true", help="stop een project zonder te vragen")
    args = parser.parse_args(argv)
    ports, terms = targets_of(parser, args.targets)
    return kill(one_per_port(read_listeners()), ports, terms, args.ja, paint_for_stdout())


def cmd_open(argv: List[str]) -> int:
    parser = parser_for("open", "Open een poort in je browser.")
    parser.add_argument("targets", nargs="+", metavar="poort[/pad]")
    args = parser.parse_args(argv)
    paint, taken, code = paint_for_stdout(), listening_ports(), 0
    print()
    for target in args.targets:
        match = re.fullmatch(r"(\d+)(/.*)?", target)
        if not match:
            parser.error(f"geen poort: {target}")
        port = port_number(match.group(1))
        if port not in taken:
            print(f"  {paint(BOLD, str(port))} luistert niet.")
            code = 1
            continue
        url = f"http://localhost:{port}{match.group(2) or ''}"
        subprocess.run([opener(), url], check=False)
        print(f"  {paint(BOLD, str(port))} geopend: {paint.link(url)}")
    print()
    return code


def cmd_logs(argv: List[str]) -> int:
    parser = parser_for("logs", "Volg de uitvoer van wat op een poort luistert.")
    parser.add_argument("port", type=port_number, metavar="poort")
    parser.add_argument("-n", "--regels", type=int, default=100, help="hoeveel regels terug (100)")
    parser.add_argument("--niet-volgen", action="store_true", help="toon de regels en stop")
    args = parser.parse_args(argv)
    paint = paint_for_stdout()
    item = next((row for row in one_per_port(read_listeners(deep=True)) if row.port == args.port), None)
    if not item:
        print(f"\n  {paint(BOLD, str(args.port))} luistert niet.\n")
        return 1
    command = logs_command(item, args.regels, not args.niet_volgen)
    if not command:
        print(f"\n  {paint(BOLD, str(args.port))} {label(item)} schrijft niet naar een bestand: {output_of(item)}.\n")
        return 1
    stop_hint = "" if args.niet_volgen else " · ctrl-c stopt"
    print(paint(DIM, f"── {args.port} {label(item)}{stop_hint} ──"), flush=True)
    os.execvp(command[0], command)
    return 0


def cmd_vrij(argv: List[str]) -> int:
    parser = parser_for("vrij", "Vind vrije poorten.")
    parser.add_argument("start", nargs="?", type=port_number, default=3000, metavar="vanaf")
    parser.add_argument("-n", "--aantal", type=int, default=1, help="hoeveel vrije poorten (1)")
    args = parser.parse_args(argv)
    found = free_ports(args.start, args.aantal, listening_ports())
    if not sys.stdout.isatty():
        print("\n".join(map(str, found)))
    else:
        paint = paint_for_stdout()
        print("\n" + "\n".join(f"  {paint(BOLD, str(port))} is {paint(FREE, 'vrij')}." for port in found) + "\n")
    return 0 if len(found) == args.aantal else 1


def cmd_wacht(argv: List[str]) -> int:
    parser = parser_for("wacht", "Wacht tot er iets op een poort luistert.")
    parser.add_argument("ports", nargs="+", type=port_number, metavar="poort")
    parser.add_argument("-t", "--timeout", type=float, default=60, help="seconden, 0 is eindeloos (60)")
    args = parser.parse_args(argv)
    paint, tty = paint_for_stdout(), sys.stdout.isatty()

    def tick(waited: float, waiting: List[int]) -> None:
        frame = SPINNER[int(waited * 4) % len(SPINNER)]
        names = " ".join(map(str, waiting))
        print(f"\r  {paint(ACCENT, frame)} wachten op {paint(BOLD, names)}  {paint(DIM, f'{int(waited)}s')}\033[K",
              end="", flush=True)

    try:
        ok, waited = wait_for_listen(args.ports, args.timeout, tick if tty else None)
    except KeyboardInterrupt:
        print()
        return 130
    clear = "\r\033[K" if tty else ""
    names = " ".join(map(str, args.ports))
    if not ok:
        print(f"{clear}  {paint(BOLD, names)} luistert na {int(waited)}s nog niet.")
        return 1
    print(f"{clear}  {paint(BOLD, names)} {paint(FREE, 'luistert')}  {paint(DIM, f'na {waited:.1f}s')}")
    return 0


COMMANDS = {"kill": cmd_kill, "open": cmd_open, "logs": cmd_logs, "vrij": cmd_vrij, "wacht": cmd_wacht}


def main(argv: Optional[List[str]] = None) -> int:
    argv = sys.argv[1:] if argv is None else list(argv)
    if argv and argv[0] in COMMANDS:
        return COMMANDS[argv[0]](argv[1:])
    return cmd_show(argv)


if __name__ == "__main__":
    sys.exit(main())
